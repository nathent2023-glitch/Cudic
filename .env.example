# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Server
PORT=3000

# Mail (HTTPS only — Render seals SMTP ports). First configured sender wins:
# Gmail API (primary, free, no domain needed — Cloud project "Cudic Mail")
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=nathen.t2023@gmail.com
# Resend (fallback; unverified domains only reach the account inbox)
RESEND_API_KEY=
# Brevo API (fallback; needs a verified sender, never configured)
BREVO_API_KEY=
BREVO_SENDER=
