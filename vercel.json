{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/games", "destination": "/games.html" },
    { "source": "/themes", "destination": "/themes.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/embed", "destination": "/embed.html" },
    { "source": "/editor", "destination": "/editor.html" },
    { "source": "/music", "destination": "/music.html" },
    { "source": "/servers", "destination": "/servers.html" },
    { "source": "/moderate", "destination": "/moderate.html" },
    { "source": "/studio", "destination": "/studio/index.html" }
  ],
  "redirects": [
    { "source": "/lobbies", "destination": "/chat", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(.*\\.js|.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/studio/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "buildCommand": "cd studio && npm ci && npm run build",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": null
}
